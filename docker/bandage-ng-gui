#!/usr/bin/python3
"""Start BandageNG in a supervised browser-accessible noVNC session."""
import argparse
import importlib.util
import json
import os
from pathlib import Path
import re
import resource
import signal
import socket
import stat
import subprocess
import sys
import tempfile
import time
import urllib.request
import uuid

sys.dont_write_bytecode = True


def emit(message):
    try:
        print(message, flush=True)
    except OSError as error:
        if error.errno not in (5, 32):
            raise
        # Complete child cleanup even after the terminal closes; logging must not interrupt finally.
        sys.stdout = open(os.devnull, 'w')


def arguments():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('--window-top-offset', type=int, default=48)
    p.add_argument('--no-fit-window', action='store_true')
    auth = p.add_mutually_exclusive_group()
    auth.add_argument('--password')
    auth.add_argument('--no-password', action='store_true')
    p.add_argument('upstream', nargs=argparse.REMAINDER)
    p.add_argument('--log-dir', type=Path, help='optional persistent parent for a unique private session/log directory')
    p.add_argument('--port', type=int, default=5801, help='HTTP port, default 5801')
    p.add_argument('--host-port', type=int, help='host mapped HTTP port for printed URL')
    p.add_argument('--vnc-port', type=int, default=5901)
    p.add_argument('--display', default=':1')
    p.add_argument('--geometry', default='1440x900', help='virtual desktop WIDTHxHEIGHT: 640..3840 by 480..2160 (default: 1440x900)')
    p.add_argument('--bind-address', default='0.0.0.0', choices=['0.0.0.0', '127.0.0.1'])
    p.add_argument('--url-host', default='127.0.0.1', help='printed host name only; does not change listening address')
    p.add_argument('--startup-timeout', type=float, default=120)
    a = p.parse_args()
    if not re.fullmatch(r':[0-9]{1,4}', a.display):
        p.error('display must have the form :N')
    match = re.fullmatch(r'([0-9]+)x([0-9]+)', a.geometry)
    if not match:
        p.error('--geometry must look like 1440x900')
    a.width, a.height = map(int, match.groups())
    if not 640 <= a.width <= 3840 or not 480 <= a.height <= 2160:
        p.error('desktop bounds: width 640..3840, height 480..2160')
    if a.window_top_offset < 0:
        p.error('--window-top-offset must be a non-negative integer')
    if not a.no_fit_window and (a.width - 20 < 640 or a.height - a.window_top_offset - 34 < 480):
        p.error('too small for the fitted workbench')
    if any(not 1024 <= port <= 65535 for port in (a.port, a.vnc_port, a.host_port if a.host_port is not None else a.port)) or a.port == a.vnc_port:
        p.error('use distinct unprivileged HTTP/VNC ports, at most 65535')
    if not 1 <= a.startup_timeout <= 300:
        p.error('startup timeout must be 1..300 seconds')
    if not re.fullmatch(r'[A-Za-z0-9._-]+', a.url_host):
        p.error('url-host must be a hostname or IPv4 address')
    a.outdir = Path.cwd()
    if a.upstream[:1] == ['--']:
        a.upstream.pop(0)
    return a


class Session:
    def __init__(self, args):
        self.a = args
        self.stopping = 0
        self.children = {}
        self.logs = []
        self.endpoints = {}
        self.ready = False
        if args.log_dir:
            args.log_dir = args.log_dir.resolve()
            args.log_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
        self.root = Path(tempfile.mkdtemp(prefix='bandage-ng-gui-', dir=args.log_dir))
        os.chmod(self.root, 0o700)
        self.token = uuid.uuid4().hex
        self.env = os.environ.copy()
        for key, name in [('HOME', 'home'), ('XDG_CONFIG_HOME', 'config'), ('XDG_CACHE_HOME', 'cache'),
                          ('XDG_RUNTIME_DIR', 'runtime'), ('TMPDIR', 'tmp')]:
            path = self.root / name
            path.mkdir(mode=0o700)
            self.env[key] = str(path)
        self.env.update(DISPLAY=args.display, TMP=self.env['TMPDIR'], TEMP=self.env['TMPDIR'],
                        PYTHONDONTWRITEBYTECODE='1')
        self.env.pop('DBUS_SESSION_BUS_ADDRESS', None)
        for key, value in [('LIBGL_ALWAYS_SOFTWARE', '1'), ('QT_OPENGL', 'software'), ('QT_X11_NO_MITSHM', '1'), ('QT_XKB_CONFIG_ROOT', '/usr/share/X11/xkb')]:
            self.env.setdefault(key, value)
        for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            signal.signal(sig, self.on_signal)

    def on_signal(self, number, frame):
        # Do not raise asynchronously: register the PID after Popen returns before entering the stop path.
        self.stopping = self.stopping or (signal.SIGTERM if number == signal.SIGHUP else number)

    def start(self, name, command):
        if self.stopping:
            raise InterruptedError()
        log = (self.root / (name + '.log')).open('wb')
        self.logs.append(log)
        child = subprocess.Popen(command, env=self.env, cwd=self.a.outdir, stdout=log,
                                 stderr=subprocess.STDOUT, start_new_session=True,
                                 umask=-1)
        self.children[name] = child
        if name == 'wm':
            (self.root / 'window-manager.pid').write_text(str(child.pid))
        (self.root / 'processes.json').write_text(json.dumps({k: v.pid for k, v in self.children.items()}))
        if self.stopping:
            raise InterruptedError()

    def check(self):
        if self.stopping:
            raise InterruptedError()
        for name, child in self.children.items():
            if child.poll() is not None:
                raise RuntimeError(f'{"window-manager" if name == "wm" else name} exited {"after" if self.ready else "before"} readiness ({child.returncode}); log: {self.root / (name + ".log")}')

    def run(self, argv):
        return subprocess.run(argv, env=self.env, capture_output=True, text=True, timeout=3)

    def capture_endpoints(self):
        child = self.children.get('xvfb')
        if not child:
            return
        number = self.a.display[1:]
        lock = Path('/tmp/.X' + number + '-lock')
        sock = Path('/tmp/.X11-unix/X' + number)
        try:
            ls = lock.lstat()
            if not stat.S_ISREG(ls.st_mode) or int(lock.read_text().strip()) != child.pid:
                return
            self.endpoints[str(lock)] = (ls.st_dev, ls.st_ino)
            ss = sock.lstat()
            if stat.S_ISSOCK(ss.st_mode):
                self.endpoints[str(sock)] = (ss.st_dev, ss.st_ino)
        except (OSError, ValueError):
            pass

    def listener_owned(self, name, port):
        # The listening inode in Linux /proc must belong to this child; do not reuse an existing listener.
        child = self.children[name]
        sockets = set()
        for fd in Path(f'/proc/{child.pid}/fd').glob('*'):
            try:
                sockets.add(os.readlink(fd))
            except OSError:
                pass
        for line in Path('/proc/net/tcp').read_text().splitlines()[1:]:
            cols = line.split()
            if int(cols[1].split(':')[1], 16) == port and cols[3] == '0A':
                if 'socket:[' + cols[9] + ']' in sockets:
                    return True
        return False

    def window(self):
        found = self.run(['xdotool', 'search', '--onlyvisible', '--name', 'Bandage'])
        if found.returncode:
            return None
        for wid in found.stdout.split():
            name = self.run(['xdotool', 'getwindowname', wid]).stdout.strip()
            if not re.match(r'^Bandage-?NG(?:$| - )', name):
                continue
            w, h = self.a.width - 20, self.a.height - self.a.window_top_offset - 34
            if not self.a.no_fit_window:
                self.run(['xdotool', 'windowsize', wid, str(w), str(h)])
                self.run(['xdotool', 'windowmove', wid, '12', str(self.a.window_top_offset + 2)])
            # Use absolute X server coordinates rather than hard-coded reparenting offsets.
            data = self.run(['xwininfo', '-id', wid]).stdout
            labels = {'X': 'Absolute upper-left X', 'Y': 'Absolute upper-left Y',
                      'WIDTH': 'Width', 'HEIGHT': 'Height'}
            values = {'WINDOW': wid}
            for key, label in labels.items():
                match = re.search(r'^\s*' + label + r':\s*(-?\d+)\s*$', data, re.M)
                if match:
                    values[key] = match.group(1)
            if not all(key in values for key in ('X', 'Y', 'WIDTH', 'HEIGHT')):
                continue
            x, y, width, height = [int(values[k]) for k in ('X', 'Y', 'WIDTH', 'HEIGHT')]
            if self.a.no_fit_window or (width == w and height == h and -24 <= x <= 80 and self.a.window_top_offset - 24 <= y <= self.a.window_top_offset + 80):
                values['desktop'] = self.a.geometry
                (self.root / 'geometry.json').write_text(json.dumps(values))
                return values
        return None

    def serve(self):
        a = self.a
        emit(f'BandageNG GUI is starting.\nInternal session logs:\n  {self.root}')
        url = f'http://{a.url_host}:{a.host_port or a.port}/vnc.html?autoconnect=1&resize=scale'
        emit(f'host URL: {url}')
        emit(f'SSH: ssh -N -L {a.host_port or a.port}:127.0.0.1:{a.host_port or a.port} user@server')
        emit('Press Ctrl-C to stop this GUI session. Publish HTTP only on host loopback.')
        for endpoint in (Path('/tmp/.X' + a.display[1:] + '-lock'), Path('/tmp/.X11-unix/X' + a.display[1:])):
            if os.path.lexists(endpoint):
                raise RuntimeError(f'occupied display endpoint (not removed): {endpoint}')
        for host, port in ((a.bind_address, a.port), ('127.0.0.1', a.vnc_port)):
            with socket.socket() as probe:
                # Allow TIME_WAIT as the actual listener does; do not use SO_REUSEPORT.
                # Active listeners still prevent binding; post-start PID/inode ownership checks guard against races.
                probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
                probe.bind((host, port))
        web = self.root / 'web'
        web.mkdir(mode=0o700)
        for source in Path('/opt/noVNC').iterdir():
            (web / source.name).symlink_to(source)
        (web / 'session-id').write_text(self.token)
        limit = resource.getrlimit(resource.RLIMIT_NOFILE)
        resource.setrlimit(resource.RLIMIT_NOFILE, (min(limit[0], 1024), limit[1]))
        self.start('xvfb', ['Xvfb', a.display, '-screen', '0', a.geometry + 'x24', '-nolisten', 'tcp', '-ac'])
        deadline = time.monotonic() + a.startup_timeout
        while self.run(['xdpyinfo', '-display', a.display]).returncode:
            self.check()
            self.capture_endpoints()
            if time.monotonic() > deadline:
                raise RuntimeError('Xvfb startup timeout')
            time.sleep(0.05)
        self.capture_endpoints()
        config = self.root / 'twmrc'
        config.write_text('NoGrabServer\nRestartPreviousState\nDecorateTransients\nRandomPlacement\nNoHighlight\n' + ''.join(x + ' "fixed"\n' for x in ['TitleFont', 'ResizeFont', 'MenuFont', 'IconFont', 'IconManagerFont']))
        self.start('wm', ['env', 'LC_ALL=C', 'twm', '-f', str(config)])
        auth_args = ['-nopw']
        if a.password:
            auth_file = self.root / 'vnc.passwd'
            self.run(['x11vnc', '-storepasswd', a.password, str(auth_file)]).check_returncode()
            auth_file.chmod(0o600)
            auth_args = ['-rfbauth', str(auth_file)]
        self.start('vnc', ['x11vnc', '-display', a.display, '-rfbport', str(a.vnc_port), '-localhost',
                           '-forever', '-shared', '-noxdamage', '-noxrecord', '-quiet'] + auth_args)
        self.start('bridge', ['websockify', '--web', str(web),
                              a.bind_address + ':' + str(a.port), '127.0.0.1:' + str(a.vnc_port)])
        self.start('app', ['dbus-run-session', '--', 'BandageNG'] + a.upstream)
        spec = importlib.util.spec_from_file_location('rfb', '/usr/local/libexec/bandage-ng/rfb-probe.py')
        rfb = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(rfb)
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        while True:
            self.check()
            try:
                owned = self.listener_owned('vnc', a.vnc_port) and self.listener_owned('bridge', a.port)
                if owned:
                    rfb.probe(a.vnc_port, a.width, a.height, password=bool(a.password), timeout=0.5)
                    with opener.open(f'http://127.0.0.1:{a.port}/session-id', timeout=0.5) as response:
                        matched = response.read(128).decode() == self.token
                    g = self.window() if matched else None
                    if g:
                        self.check()
                        break
            except (OSError, ValueError):
                pass
            if time.monotonic() > deadline:
                raise RuntimeError('GUI readiness timeout; inspect component logs')
            time.sleep(0.1)
        self.ready = True
        emit('BandageNG GUI is ready.')
        emit(f'Main window: {g["WIDTH"]}x{g["HEIGHT"]} at {g["X"]},{g["Y"]} within {a.geometry} ({"native" if a.no_fit_window else "fit"}).')
        (self.root / 'window-layout.log').write_text(json.dumps(g))
        while True:
            if self.stopping:
                raise InterruptedError()
            app = self.children['app']
            if app.poll() == 0:
                return 0
            self.check()
            time.sleep(0.1)

    def cleanup(self):
        reason = 'Ctrl-C' if self.stopping == signal.SIGINT else 'TERM' if self.stopping else 'exit'
        emit(f'Stopping BandageNG GUI ({reason}).')
        # An early INT may precede Xvfb socket creation; wait briefly and record only endpoints with matching PID ownership.
        if 'xvfb' in self.children:
            for _ in range(10):
                self.capture_endpoints()
                if len(self.endpoints) == 2 or self.children['xvfb'].poll() is not None:
                    break
                time.sleep(0.05)
        for child in reversed(list(self.children.values())):
            try:
                os.killpg(child.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
        deadline = time.monotonic() + 3
        while time.monotonic() < deadline and any(c.poll() is None for c in self.children.values()):
            time.sleep(0.05)
        for child in self.children.values():
            try:
                os.killpg(child.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            child.wait(timeout=2)
        for name, identity in self.endpoints.items():
            path = Path(name)
            try:
                info = path.lstat()
                if not stat.S_ISLNK(info.st_mode) and (info.st_dev, info.st_ino) == identity:
                    path.unlink()
            except FileNotFoundError:
                pass
        (self.root / 'vnc.passwd').unlink(missing_ok=True)
        for log in self.logs:
            log.close()
        emit('stopped; owned process groups and display endpoints cleaned')


def main():
    session = Session(arguments())
    result = 1
    try:
        result = session.serve()
    except InterruptedError:
        result = 128 + session.stopping
    except Exception as error:
        emit(f'ERROR: {error}')
        for name in session.children:
            path = session.root / (name + '.log')
            tail = path.read_text(errors='replace').splitlines()[-10:]
            emit(f'{name} log tail:\n' + '\n'.join(tail))
    finally:
        session.cleanup()
    return result


if __name__ == '__main__':
    sys.exit(main())
